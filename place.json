      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tKWWREUkJablJIU2taSVZXVkZTbkpCU2xwTlJtYxAB!2m1!1s0xd41f305e42ea891:0x2a3c9d24fc5dab9b"
