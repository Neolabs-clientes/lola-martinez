    {
      "name": "places/ChIJkagu5AXzQQ0Rm6td_CSdPCo/reviews/Ci9DQUlRQUNvZENodHljRjlvT21kc2MzaFNlRzgzY1hCd1dWRnVTWFZDZVdab04xRRAB",
      "relativePublishTimeDescription": "2 months ago",
      "rating": 5,
      "text": {
        "text": "I love how Lola works. I've known her for over 10 years and I get my nails done by her, and I can say she's a true professional. Her designs are original and always on trend.",
        "languageCode": "en-US"
      },
      "originalText": {
        "text": "Me encanta como trabaja Lola.\nHace más de 10 años que la conozco y me hago las uñas con ella y puedo decir que es una gran profesional. Sus diseños son originales y siempre a la última.",
        "languageCode": "es"
      },
